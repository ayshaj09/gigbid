APP_ENV=development
APP_SECRET_KEY=replace_me
DATABASE_URL=postgresql+psycopg://gigbid:gigbid@localhost:5432/gigbid
REDIS_URL=redis://localhost:6379/0
# Marketplace: gigsim | upwork_live. GIGSIM_BASE_URL=fixture:// uses the in-memory stand-in.
MARKETPLACE_MODE=gigsim
GIGSIM_BASE_URL=http://localhost:8081
GIGSIM_API_TOKEN=replace_me
# Models: open (required) | paid | offline (rules only)
MODEL_PROFILE=open
OPEN_MODEL_BASE_URL=http://localhost:11434/v1
OPEN_MODEL_API_KEY=ollama
PAID_MODEL_BASE_URL=
PAID_MODEL_API_KEY=
OLLAMA_URL=http://localhost:11434
RETRIEVAL_VARIANT=
# MCP over HTTP: comma-separated token:user pairs
MCP_TRANSPORT=stdio
MCP_TOKENS=
PORTFOLIO_PERSONA=ai_engineer
PORTFOLIO_DIR=
WORKSPACE_TZ=Asia/Karachi
GIGBID_DATA_DIR=data/processed
LANGSMITH_API_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
